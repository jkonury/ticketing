# 로컬 개발용 값. `cp .env.example .env` 후 사용한다 (.env는 git 제외).
TICKETING_POSTGRES_DB=ticketing
TICKETING_POSTGRES_USER=ticketing
TICKETING_POSTGRES_PASSWORD=change-me
TICKETING_PAYMENT_POSTGRES_DB=payment_db
TICKETING_PAYMENT_POSTGRES_USER=payment
TICKETING_PAYMENT_POSTGRES_PASSWORD=change-me
TICKETING_JWT_SECRET=change-me-to-a-random-string-of-32-bytes-or-more
# 기동 시 이 이메일의 회원을 ADMIN으로 승격한다(먼저 가입 필요). 비우면 동작하지 않는다.
TICKETING_ADMIN_BOOTSTRAP_EMAIL=
# fake-pg 웹훅 서명 키. 코어도 같은 값을 써야 서명 검증이 통과한다
FAKE_PG_WEBHOOK_SECRET=change-me-to-a-random-string

# Nginx 템플릿 렌더링용. 실제 도메인으로 바꾼다.
TICKETING_DOMAIN=example.invalid
# nginx 사용 시 openssl rand -hex 32로 생성하고 web/.env.local에도 같은 값을 둔다.
TICKETING_INGRESS_PROOF=

# 개발 Java 앱은 Scouter를 사용한다. scouter.agent.jar가 있는 절대 경로로 바꾼다.
# 부하 테스트는 --no-scouter로 비활성화할 수 있다.
# SCOUTER_AGENT_DIR=/absolute/path/to/scouter/agent.java21plus
SCOUTER_COLLECTOR_IP=127.0.0.1
