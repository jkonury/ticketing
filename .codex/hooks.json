{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/agent/hook/command_policy.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/agent/hook/stop_quality.sh\"",
            "timeout": 600,
            "statusMessage": "ktlint·detekt 검사 중"
          }
        ]
      }
    ]
  }
}
