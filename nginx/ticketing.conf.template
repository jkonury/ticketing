# 공통 http 설정의 TLS와 WebSocket upgrade map을 사용한다.
upstream ticketing_dev_web {
    server 127.0.0.1:13000;
    keepalive 16;
}

upstream ticketing_dev_gateway {
    server 127.0.0.1:18000;
    keepalive 16;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${TICKETING_DOMAIN};

    # 두 location이 같은 헤더를 상속하도록 서버 블록에서 한 번 설정한다.
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header X-Forwarded-Prefix "";
    proxy_set_header X-Forwarded-Ssl "";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Client-IP "";
    proxy_set_header X-Client-IP "";
    proxy_set_header X-Cluster-Client-IP "";
    proxy_set_header True-Client-IP "";
    proxy_set_header CF-Connecting-IP "";
    proxy_set_header X-Ticketing-Client-IP $remote_addr;
    proxy_set_header X-Ticketing-Ingress-Proof "${TICKETING_INGRESS_PROOF}";
    proxy_hide_header X-Ticketing-Client-IP;
    proxy_hide_header X-Ticketing-Ingress-Proof;

    location ^~ /api/v1/streams/ {
        proxy_pass http://ticketing_dev_gateway;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 90s;
    }

    location / {
        proxy_pass http://ticketing_dev_web;
    }
}
