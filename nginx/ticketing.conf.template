# 공통 http 설정의 TLS와 프록시 헤더를 상속한다.
upstream ticketing_dev_web {
    server 127.0.0.1:13000;
    keepalive 16;
}

upstream ticketing_dev_gateway {
    server 127.0.0.1:18000;
    keepalive 16;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${TICKETING_DOMAIN};

    location ^~ /api/v1/streams/ {
        proxy_pass http://ticketing_dev_gateway;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 90s;
    }

    location / {
        proxy_pass http://ticketing_dev_web;
    }
}
