{
  "groups": [
    {
      "name": "ticketing-operations",
      "rules": [
        {
          "alert": "AppDown",
          "expr": "up{job=\"apps\"} == 0",
          "for": "1m",
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "{{ $labels.service }} 앱을 스크레이프할 수 없음",
            "runbook": "https://github.com/jkonury/ticketing/blob/main/docs/runbook.md#38-알림이-울렸다",
            "panel": "앱 상태"
          }
        },
        {
          "alert": "HighErrorRate",
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{job=\"apps\",status=~\"5..\"}[5m])) / sum by (application) (rate(http_server_requests_seconds_count{job=\"apps\"}[5m])) > 0.05",
          "for": "5m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "{{ $labels.application }} 앱의 HTTP 5xx 비율이 5%를 초과함",
            "runbook": "https://github.com/jkonury/ticketing/blob/main/docs/runbook.md#38-알림이-울렸다",
            "panel": "HTTP 5xx 비율"
          }
        },
        {
          "alert": "EventPublicationStuck",
          "expr": "max by (application) (ticketing_event_publication_oldest_incomplete_age_seconds{job=\"apps\"}) > 300",
          "for": "5m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "{{ $labels.application }} 앱에 300초를 넘긴 미완료 이벤트가 있음",
            "runbook": "https://github.com/jkonury/ticketing/blob/main/docs/runbook.md#38-알림이-울렸다",
            "panel": "최고령 미완료 이벤트 경과"
          }
        },
        {
          "alert": "KafkaConsumerLagHigh",
          "expr": "sum by (consumergroup, topic) (clamp_min(kafka_consumergroup_lag{job=\"kafka\"}, 0)) > 1000",
          "for": "5m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "{{ $labels.consumergroup }} 그룹의 {{ $labels.topic }} lag가 1000건을 초과함",
            "runbook": "https://github.com/jkonury/ticketing/blob/main/docs/runbook.md#38-알림이-울렸다",
            "panel": "컨슈머 그룹 lag"
          }
        },
        {
          "alert": "KafkaDeadLetterIncreased",
          "expr": "sum by (topic) (increase(kafka_topic_partition_current_offset{job=\"kafka\",topic=~\".+[.]dlt\"}[10m])) > 0",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "{{ $labels.topic }} 토픽에 최근 10분 동안 DLT 레코드가 추가됨",
            "runbook": "https://github.com/jkonury/ticketing/blob/main/docs/runbook.md#38-알림이-울렸다",
            "panel": "최근 10분 DLT 증가"
          }
        },
        {
          "alert": "BatchJobFailed",
          "expr": "max by (application, exported_job) (ticketing_batch_job_failed{job=\"apps\"}) == 1",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "{{ $labels.application }} 앱의 {{ $labels.exported_job }} 배치 실행이 실패함",
            "runbook": "https://github.com/jkonury/ticketing/blob/main/docs/runbook.md#38-알림이-울렸다",
            "panel": "Job별 마지막 상태"
          }
        },
        {
          "alert": "HikariPoolExhausted",
          "expr": "hikaricp_connections_pending{job=\"apps\"} > 0",
          "for": "2m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "{{ $labels.application }} 앱의 {{ $labels.pool }} 연결 풀에서 대기가 지속됨",
            "runbook": "https://github.com/jkonury/ticketing/blob/main/docs/runbook.md#38-알림이-울렸다",
            "panel": "Hikari 연결 대기"
          }
        }
      ]
    }
  ]
}
