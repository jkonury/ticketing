{
  "uid": "ticketing-overview",
  "title": "Ticketing Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "ticketing"
  ],
  "links": [
    {
      "type": "link",
      "title": "Ticketing Load Test",
      "url": "/d/ticketing-loadtest"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"apps\"}, service)",
          "refId": "application"
        },
        "definition": "label_values(up{job=\"apps\"}, service)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "상태 요약",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "앱 상태",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"apps\",service=~\"$application\"}",
          "legendFormat": "{{service}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "발화 중 알림",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 5,
        "y": 1,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "전체",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "미완료 이벤트 발행 건수",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 9,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (application) (ticketing_event_publication_incomplete{job=\"apps\",application=~\"$application\"}))",
          "legendFormat": "미완료",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "최근 10분 DLT 증가",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 14,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.001
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (increase(kafka_topic_partition_current_offset{job=\"kafka\",topic=~\".+[.]dlt\"}[10m]))",
          "legendFormat": "{{topic}}",
          "instant": true,
          "range": false
        }
      ],
      "description": "Kafka exporter가 수집한 전체 DLT 토픽의 오프셋 증가량",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "실패 Batch Job 수",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 19,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (application, exported_job) (ticketing_batch_job_failed{job=\"apps\",application=~\"$application\"}))",
          "legendFormat": "실패",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "트래픽",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "HTTP 요청 수",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{job=\"apps\",application=~\"$application\"}[$__rate_interval]))",
          "legendFormat": "{{application}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "HTTP 5xx 비율",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum by (application) (rate(http_server_requests_seconds_count{job=\"apps\",application=~\"$application\",status=~\"5..\"}[$__rate_interval]))) or on (application) (0 * sum by (application) (rate(http_server_requests_seconds_count{job=\"apps\",application=~\"$application\"}[$__rate_interval])))) / (sum by (application) (rate(http_server_requests_seconds_count{job=\"apps\",application=~\"$application\"}[$__rate_interval])))",
          "legendFormat": "{{application}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "HTTP 응답 시간 p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, application) (rate(http_server_requests_seconds_bucket{job=\"apps\",application=~\"$application\"}[$__rate_interval])))",
          "legendFormat": "{{application}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "비동기 흐름",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "컨슈머 그룹 lag",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (consumergroup, topic) (clamp_min(kafka_consumergroup_lag{job=\"kafka\"}, 0))",
          "legendFormat": "{{consumergroup}} · {{topic}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "토픽별 DLT 적재",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application, topic) (rate(ticketing_kafka_dead_letter_total{job=\"apps\",application=~\"$application\"}[$__rate_interval]))",
          "legendFormat": "{{application}} · {{topic}}",
          "instant": false,
          "range": true
        }
      ],
      "description": "실패를 DLT로 보낸 앱의 카운터. 토픽 라벨에는 원본 토픽 이름을 사용한다."
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "최고령 미완료 이벤트 경과",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (application) (ticketing_event_publication_oldest_incomplete_age_seconds{job=\"apps\",application=~\"$application\"})",
          "legendFormat": "{{application}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "결제 확정 지연 p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, application) (rate(ticketing_booking_payment_confirmation_lag_seconds_bucket{job=\"apps\",application=~\"$application\"}[$__rate_interval])))",
          "legendFormat": "{{application}}",
          "instant": false,
          "range": true
        }
      ],
      "description": "PG 승인부터 예매 확정까지 걸리는 시간"
    },
    {
      "id": 16,
      "type": "row",
      "title": "Batch",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Job별 마지막 상태",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "실패 없음",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "실패",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (application, exported_job) (ticketing_batch_job_failed{job=\"apps\",application=~\"$application\"})",
          "legendFormat": "{{application}} · {{exported_job}}",
          "instant": true,
          "range": false
        }
      ],
      "description": "가장 최근에 종료된 실행이 FAILED 또는 ABANDONED이면 실패로 표시한다.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 18,
      "type": "stat",
      "title": "Job별 마지막 성공 시각",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (application, exported_job) (ticketing_batch_job_last_success_seconds{job=\"apps\",application=~\"$application\"}) * 1000",
          "legendFormat": "{{application}} · {{exported_job}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 19,
      "type": "row",
      "title": "자원 요약",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "JVM 힙 사용률",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (jvm_memory_used_bytes{job=\"apps\",application=~\"$application\",area=\"heap\"}) / sum by (application) (jvm_memory_max_bytes{job=\"apps\",application=~\"$application\",area=\"heap\"} > 0)",
          "legendFormat": "{{application}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Hikari 연결 대기",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 37,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_pending{job=\"apps\",application=~\"$application\"}",
          "legendFormat": "{{application}} · {{pool}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "CPU 사용률",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 37,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage{job=\"apps\",application=~\"$application\"}",
          "legendFormat": "{{application}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "PostgreSQL 연결 수",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pg_stat_database_numbackends{job=\"postgres\",datname!~\"template.*|postgres\"})",
          "legendFormat": "전체",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Redis 메모리",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 44,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_memory_used_bytes{job=\"redis\"}",
          "legendFormat": "사용량",
          "instant": false,
          "range": true
        }
      ]
    }
  ]
}
