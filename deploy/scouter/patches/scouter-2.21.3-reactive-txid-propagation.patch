+package scouter.xtra.reactive;
+
+import io.micrometer.context.ContextRegistry;
+import io.micrometer.context.ThreadLocalAccessor;
+import scouter.agent.trace.TraceContext;
+import scouter.agent.trace.TraceContextManager;
+
+/**
+ * Micrometer context-propagation accessor that bridges the Reactor Context entry
+ * (key = TraceContext.class, put by subscriptOnContext) and the txid ThreadLocal of TraceContextManager.
+ * Loaded only when _hook_reactive_txid_propagation=context_propagation, so the app's
+ * context-propagation library is never required otherwise.
+ */
+public class TraceContextThreadLocalAccessor implements ThreadLocalAccessor<TraceContext> {
+
+    /** @throws Throwable (NoClassDefFoundError etc.) when context-propagation is not available */
+    static void register() {
+        ContextRegistry.getInstance().registerThreadLocalAccessor(new TraceContextThreadLocalAccessor());
+    }
+
+    @Override
+    public Object key() {
+        return TraceContext.class;
+    }
+
+    @Override
+    public TraceContext getValue() {
+        if (TraceContextManager.getLocalTxid() == null) {
+            return null;
+        }
+        return TraceContextManager.getContext(true);
+    }
+
+    @Override
+    public void setValue(TraceContext value) {
+        TraceContextManager.setTxidLocal(value.txid);
+    }
+
+    @Override
+    public void setValue() {
+        TraceContextManager.setTxidLocal(null);
+    }
+
+    /** for context-propagation 1.0.0~1.0.2 which call reset() */
+    @Override
+    @Deprecated
+    public void reset() {
+        TraceContextManager.setTxidLocal(null);
+    }
+}
