@@ -0,0 +1,111 @@
+package scouter.xtra.reactive;
+
+import org.reactivestreams.Subscription;
+import reactor.core.CoreSubscriber;
+import reactor.core.Scannable;
+import reactor.util.context.Context;
+import scouter.agent.Configure;
+import scouter.agent.Logger;
+import scouter.agent.trace.TraceContext;
+import scouter.agent.trace.TraceContextManager;
+
+/**
+ * Lightweight variant of {@link ReactiveSupportWithCoroutine.TxidLifter} used when
+ * _hook_reactive_txid_propagation=lift_light and profile_reactor_checkpoint_enabled=false.
+ * It only restores the txid ThreadLocal: no checkpoint search, no Context re-allocation (the downstream
+ * subscriber's Context is returned as is) and optional scannable tracking.
+ */
+public class LightTxidLifter<T> implements SpanSubscription<T>, Scannable {
+
+    private static final Configure configure = Configure.getInstance();
+
+    private final CoreSubscriber<T> coreSubscriber;
+    private final Scannable scannable;
+    private final TraceContext traceContext;
+    private final boolean trackScannable;
+    private Subscription orgSubs;
+
+    public LightTxidLifter(CoreSubscriber<T> coreSubscriber, Scannable scannable, TraceContext traceContext) {
+        this.coreSubscriber = coreSubscriber;
+        this.scannable = scannable;
+        this.traceContext = traceContext;
+        this.trackScannable = configure._hook_reactive_scannable_tracking_enabled;
+    }
+
+    @Override
+    public void onSubscribe(Subscription subs) {
+        copyToThread();
+        if (trackScannable) {
+            try {
+                traceContext.scannables.put(scannable.hashCode(),
+                        new TraceContext.TimedScannable(System.currentTimeMillis(), scannable));
+            } catch (Throwable e) {
+                Logger.println("[R109L]", "reactive support onSubscribe error.", e);
+            }
+        }
+        this.orgSubs = subs;
+        coreSubscriber.onSubscribe(this);
+    }
+
+    @Override
+    public void onNext(T t) {
+        copyToThread();
+        coreSubscriber.onNext(t);
+    }
+
+    @Override
+    public void onError(Throwable throwable) {
+        copyToThread();
+        untrack();
+        coreSubscriber.onError(throwable);
+    }
+
+    @Override
+    public void onComplete() {
+        copyToThread();
+        untrack();
+        coreSubscriber.onComplete();
+    }
+
+    @Override
+    public void request(long n) {
+        this.orgSubs.request(n);
+    }
+
+    @Override
+    public void cancel() {
+        copyToThread();
+        untrack();
+        this.orgSubs.cancel();
+    }
+
+    @Override
+    public Context currentContext() {
+        return coreSubscriber.currentContext();
+    }
+
+    @Override
+    public Object scanUnsafe(Attr key) {
+        if (key == Attr.PARENT) {
+            return this.orgSubs;
+        }
+        return key == Attr.ACTUAL ? this.coreSubscriber : null;
+    }
+
+    private void untrack() {
+        if (trackScannable) {
+            try {
+                traceContext.scannables.remove(scannable.hashCode());
+            } catch (Throwable e) {
+                Logger.println("[R110L]", "reactive support untrack error.", e);
+            }
+        }
+    }
+
+    private void copyToThread() {
+        Long threadLocalTxid = TraceContextManager.getLocalTxid();
+        if (threadLocalTxid == null || threadLocalTxid != traceContext.txid) {
+            TraceContextManager.setTxidLocal(traceContext.txid);
+        }
+    }
+}
