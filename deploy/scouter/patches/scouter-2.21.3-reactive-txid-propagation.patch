+package scouter.xtra.reactive;
+
+import io.micrometer.context.ContextRegistry;
+import io.micrometer.context.ContextSnapshot;
+import io.micrometer.context.ContextSnapshotFactory;
+import org.junit.After;
+import org.junit.Test;
+import org.reactivestreams.Subscription;
+import reactor.core.CoreSubscriber;
+import reactor.core.Scannable;
+import reactor.core.publisher.Mono;
+import reactor.util.context.Context;
+import scouter.agent.trace.TraceContext;
+import scouter.agent.trace.TraceContextManager;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertSame;
+import static org.junit.Assert.assertTrue;
+
+public class ReactiveTxidPropagationTest {
+
+    @After
+    public void cleanup() {
+        TraceContextManager.setTxidLocal(null);
+    }
+
+    private TraceContext newTraceContext(long txid) {
+        TraceContext ctx = new TraceContext(false);
+        ctx.txid = txid;
+        ctx.initScannables();
+        TraceContextManager.start(ctx);
+        return ctx;
+    }
+
+    @Test
+    public void accessorKeyMatchesKeyUsedBySubscriptOnContext() {
+        assertSame(TraceContext.class, new TraceContextThreadLocalAccessor().key());
+    }
+
+    @Test
+    public void setValueSetsLocalTxidAndGetValueReturnsContext() {
+        TraceContext ctx = newTraceContext(910001L);
+        TraceContextThreadLocalAccessor accessor = new TraceContextThreadLocalAccessor();
+        TraceContextManager.setTxidLocal(null);
+        assertNull(accessor.getValue());
+
+        accessor.setValue(ctx);
+        assertEquals(Long.valueOf(910001L), TraceContextManager.getLocalTxid());
+        assertSame(ctx, accessor.getValue());
+
+        accessor.setValue();
+        assertNull(TraceContextManager.getLocalTxid());
+        assertNull(accessor.getValue());
+    }
+
+    @Test
+    public void snapshotScopeSetsAndRestoresPreviousTxid() {
+        TraceContext other = newTraceContext(910002L);
+        TraceContext mine = newTraceContext(910003L);
+        ContextRegistry registry = new ContextRegistry();
+        registry.registerThreadLocalAccessor(new TraceContextThreadLocalAccessor());
+        ContextSnapshotFactory factory = ContextSnapshotFactory.builder().contextRegistry(registry).build();
+
+        TraceContextManager.setTxidLocal(mine.txid);
+        ContextSnapshot snapshot = factory.captureAll();
+
+        // 1) previous value exists -> restored after scope
+        TraceContextManager.setTxidLocal(other.txid);
+        try (ContextSnapshot.Scope ignored = snapshot.setThreadLocals()) {
+            assertEquals(Long.valueOf(910003L), TraceContextManager.getLocalTxid());
+        }
+        assertEquals(Long.valueOf(910002L), TraceContextManager.getLocalTxid());
+
+        // 2) no previous value -> cleared after scope
+        TraceContextManager.setTxidLocal(null);
+        try (ContextSnapshot.Scope ignored = snapshot.setThreadLocals()) {
+            assertEquals(Long.valueOf(910003L), TraceContextManager.getLocalTxid());
+        }
+        assertNull(TraceContextManager.getLocalTxid());
+    }
+
+    @Test
+    public void lightLifterReturnsDownstreamContextWithoutAllocation() {
+        final TraceContext ctx = newTraceContext(910004L);
+        final Context downstream = Context.of(TraceContext.class, ctx);
+        final long[] seenTxid = new long[1];
+        CoreSubscriber<Object> subscriber = new CoreSubscriber<Object>() {
+            @Override public Context currentContext() { return downstream; }
+            @Override public void onSubscribe(Subscription s) { }
+            @Override public void onNext(Object o) {
+                Long t = TraceContextManager.getLocalTxid();
+                seenTxid[0] = t == null ? -1 : t;
+            }
+            @Override public void onError(Throwable t) { }
+            @Override public void onComplete() { }
+        };
+        Scannable scannable = Scannable.from(Mono.just(1));
+        LightTxidLifter<Object> lifter = new LightTxidLifter<Object>(subscriber, scannable, ctx);
+
+        assertSame(downstream, lifter.currentContext());
+        assertTrue(lifter.currentContext() == lifter.currentContext());
+
+        TraceContextManager.setTxidLocal(null);
+        lifter.onNext("x");
+        assertEquals(910004L, seenTxid[0]);
+    }
+
+    @Test
+    public void lightLifterTracksScannablesOnlyWhenEnabled() {
+        final TraceContext ctx = newTraceContext(910005L);
+        CoreSubscriber<Object> subscriber = new CoreSubscriber<Object>() {
+            @Override public Context currentContext() { return Context.empty(); }
+            @Override public void onSubscribe(Subscription s) { }
+            @Override public void onNext(Object o) { }
+            @Override public void onError(Throwable t) { }
+            @Override public void onComplete() { }
+        };
+        Subscription subs = new Subscription() {
+            @Override public void request(long n) { }
+            @Override public void cancel() { }
+        };
+        Scannable scannable = Scannable.from(Mono.just(1));
+        scouter.agent.Configure conf = scouter.agent.Configure.getInstance();
+        boolean old = conf._hook_reactive_scannable_tracking_enabled;
+        try {
+            conf._hook_reactive_scannable_tracking_enabled = false;
+            LightTxidLifter<Object> off = new LightTxidLifter<Object>(subscriber, scannable, ctx);
+            off.onSubscribe(subs);
+            assertEquals(0, ctx.scannables.size());
+
+            conf._hook_reactive_scannable_tracking_enabled = true;
+            LightTxidLifter<Object> on = new LightTxidLifter<Object>(subscriber, scannable, ctx);
+            on.onSubscribe(subs);
+            assertEquals(1, ctx.scannables.size());
+            on.onComplete();
+            assertEquals(0, ctx.scannables.size());
+        } finally {
+            conf._hook_reactive_scannable_tracking_enabled = old;
+        }
+    }
+}
