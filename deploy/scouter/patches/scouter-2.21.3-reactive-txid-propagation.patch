index 00000000..21eacd9e
--- /dev/null
+++ i/scouter.agent.java/src/main/java/scouter/xtra/reactive/ReactiveTxidPropagation.java
@@ -0,0 +1,104 @@
+package scouter.xtra.reactive;
+
+import reactor.core.CoreSubscriber;
+import reactor.core.Fuseable;
+import reactor.core.Scannable;
+import reactor.core.publisher.Hooks;
+import reactor.core.publisher.Operators;
+import reactor.util.context.Context;
+import scouter.agent.AgentCommonConstant;
+import scouter.agent.Configure;
+import scouter.agent.Logger;
+import scouter.agent.trace.TraceContext;
+
+import java.util.function.BiFunction;
+
+/**
+ * Selects how the txid is propagated to reactor threads (_hook_reactive_txid_propagation).
+ * Shared by ReactiveSupport and ReactiveSupportWithCoroutine.
+ */
+final class ReactiveTxidPropagation {
+
+    static final String MODE_LIFT = "lift";
+    static final String MODE_LIFT_LIGHT = "lift_light";
+    static final String MODE_CONTEXT_PROPAGATION = "context_propagation";
+
+    private ReactiveTxidPropagation() {
+    }
+
+    interface LifterFactory {
+        CoreSubscriber<? super Object> create(CoreSubscriber<? super Object> subscriber, Scannable scannable,
+                                              TraceContext traceContext);
+    }
+
+    /** @param legacyLifter factory of the original TxidLifter, used for lift mode and as a fallback */
+    static void install(Configure configure, LifterFactory legacyLifter) {
+        String mode = configure._hook_reactive_txid_propagation;
+        if (MODE_CONTEXT_PROPAGATION.equals(mode)) {
+            if (registerContextPropagation()) {
+                return;
+            }
+            Logger.println("R168", "context_propagation unavailable. fallback to lift");
+        } else if (MODE_LIFT_LIGHT.equals(mode)) {
+            if (!configure.profile_reactor_checkpoint_enabled) {
+                hookLift(new LifterFactory() {
+                    @Override
+                    @SuppressWarnings({"unchecked", "rawtypes"})
+                    public CoreSubscriber<? super Object> create(CoreSubscriber<? super Object> subscriber,
+                                                                 Scannable scannable, TraceContext traceContext) {
+                        return new LightTxidLifter(subscriber, scannable, traceContext);
+                    }
+                });
+                return;
+            }
+            Logger.println("R169", "lift_light requires profile_reactor_checkpoint_enabled=false. use lift");
+        } else if (!MODE_LIFT.equals(mode)) {
+            Logger.println("R170", "unknown _hook_reactive_txid_propagation=" + mode + ". use lift");
+        }
+        hookLift(legacyLifter);
+    }
+
+    private static void hookLift(final LifterFactory factory) {
+        try {
+            Hooks.onEachOperator(AgentCommonConstant.TRACE_ID, Operators.lift(
+                    new BiFunction<Scannable, CoreSubscriber<? super Object>, CoreSubscriber<? super Object>>() {
+                        @Override
+                        public CoreSubscriber<? super Object> apply(Scannable scannable,
+                                                                    CoreSubscriber<? super Object> subscriber) {
+                            try {
+                                if (scannable instanceof Fuseable.ScalarCallable) {
+                                    return subscriber;
+                                }
+                                Context context = subscriber.currentContext();
+                                if (scannable == null || context == null) {
+                                    return subscriber;
+                                }
+                                TraceContext traceContext = context.getOrDefault(TraceContext.class, null);
+                                if (traceContext != null) {
+                                    return factory.create(subscriber, scannable, traceContext);
+                                }
+                                return subscriber;
+                            } catch (Exception e) {
+                                Logger.println("R1660", e.getMessage(), e);
+                                return subscriber;
+                            }
+                        }
+                    }));
+        } catch (Throwable e) {
+            Logger.println("R166", e.getMessage(), e);
+        }
+    }
+
+    private static boolean registerContextPropagation() {
+        try {
+            TraceContextThreadLocalAccessor.register();
+            Logger.println("R171", "reactive txid propagation: micrometer context-propagation accessor registered. "
+                    + "The app must enable Hooks.enableAutomaticContextPropagation() "
+                    + "(spring.reactor.context-propagation=auto) or the txid is not propagated across threads.");
+            return true;
+        } catch (Throwable e) {
+            Logger.println("R172", "context-propagation registration failed: " + e, e);
+            return false;
+        }
+    }
+}
